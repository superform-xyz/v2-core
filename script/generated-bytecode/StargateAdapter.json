9106:3;9102:19;9097:2;9086:9;9082:18;9075:47;9145:41;9182:3;9174:6;9145:41;:::i;:::-;9131:55;;;9235:9;9227:6;9223:22;9217:3;9206:9;9202:19;9195:51;9269:32;9294:6;9286;9269:32;:::i;:::-;9255:46;;9350:9;9342:6;9338:22;9332:3;9321:9;9317:19;9310:51;9384:32;9409:6;9401;9384:32;:::i;:::-;9370:46;;9465:9;9457:6;9453:22;9447:3;9436:9;9432:19;9425:51;9493:32;9518:6;9510;9493:32;:::i;:::-;9485:40;8042:1489;-1:-1:-1;;;;;;;;;;8042:1489:986:o","linkReferences":{},"immutableReferences":{"187651":[{"start":82,"length":32},{"start":227,"length":32}],"187655":[{"start":182,"length":32},{"start":822,"length":32}]}},"methodIdentifiers":{"LZ_ENDPOINT()":"cd4d1c64","SUPER_DESTINATION_EXECUTOR()":"f2ad8247","lzCompose(address,bytes32,bytes,address,bytes)":"d0a10260"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"lzEndpoint_\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"superDestinationExecutor_\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"ADDRESS_NOT_VALID\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"COMPOSE_MSG_TOO_SHORT\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ETH_TRANSFER_FAILED\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"INVALID_SENDER\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"SafeERC20FailedOperation\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"tokenSent\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"ComposeExecuted\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"LZ_ENDPOINT\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"SUPER_DESTINATION_EXECUTOR\",\"outputs\":[{\"internalType\":\"contract ISuperDestinationExecutor\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_from\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"_message\",\"type\":\"bytes\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"name\":\"lzCompose\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"author\":\"Superform Labs\",\"details\":\"Supports both Stargate pool tokens (taxi/bus modes) and generic OFT tokensToken delivery happens in a separate transaction (lzReceive) before lzCompose is calledUses amountLD from OFTComposeMsgCodec header (bytes 12-44) for transfers, ensuring eachcompose only transfers the exact amount credited during its corresponding lzReceive\",\"errors\":{\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"events\":{\"ComposeExecuted(address,address,uint256)\":{\"params\":{\"account\":\"The target account that received the tokens\",\"amount\":\"The amount of tokens transferred\",\"tokenSent\":\"The token address transferred (address(0) for native ETH)\"}}},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"lzEndpoint_\":\"The LayerZero V2 EndpointV2 address\",\"superDestinationExecutor_\":\"The SuperDestinationExecutor address\"}},\"lzCompose(address,bytes32,bytes,address,bytes)\":{\"details\":\"Decodes the OFTComposeMsgCodec message, transfers tokens to the target account,      and forwards the execution payload to SuperDestinationExecutorThe _from parameter is the destination Stargate pool or OFT contract (NOT the source chain sender)Uses amountLD from OFTComposeMsgCodec header for precise per-compose transfers\",\"params\":{\"_executor\":\"The address of the executor for the composed message\",\"_extraData\":\"Additional arbitrary data passed by the executor\",\"_from\":\"The address initiating the composition (destination OApp/pool, NOT the source chain sender)\",\"_guid\":\"The unique identifier for the corresponding LayerZero src/dst tx\",\"_message\":\"The composed message payload (OFTComposeMsgCodec-encoded)\"}}},\"stateVariables\":{\"COMPOSE_MSG_OFFSET\":{\"details\":\"Layout: nonce(8) + srcEid(4) + amountLD(32) + composeFrom(32) = 76 bytes header\"},\"LZ_ENDPOINT\":{\"details\":\"Same on all EVM chains: 0x1a44076050125825900e736c501f859c50fE728c\"}},\"title\":\"StargateAdapter\",\"version\":1},\"userdoc\":{\"errors\":{\"ADDRESS_NOT_VALID()\":[{\"notice\":\"Thrown when a constructor argument is the zero address\"}],\"COMPOSE_MSG_TOO_SHORT()\":[{\"notice\":\"Thrown when the compose message is too short to contain the OFTComposeMsgCodec header\"}],\"ETH_TRANSFER_FAILED()\":[{\"notice\":\"Thrown when native ETH transfer to the target account fails\"}],\"INVALID_SENDER()\":[{\"notice\":\"Thrown when lzCompose is called by an address other than the LZ endpoint\"}]},\"events\":{\"ComposeExecuted(address,address,uint256)\":{\"notice\":\"Emitted when a compose message is successfully executed\"}},\"kind\":\"user\",\"methods\":{\"LZ_ENDPOINT()\":{\"notice\":\"The LayerZero V2 EndpointV2 address\"},\"SUPER_DESTINATION_EXECUTOR()\":{\"notice\":\"The SuperDestinationExecutor for processing bridged executions\"},\"lzCompose(address,bytes32,bytes,address,bytes)\":{\"notice\":\"Composes a LayerZero message from an OApp\"}},\"notice\":\"Receives LayerZero V2 compose messages from Stargate/OFT and forwards them to the SuperDestinationExecutor.This contract acts as a translator between LayerZero V2 compose callbacks and the core Superform execution logic.\",\"version\":1}},\"settin