type\":\"uint256\"}],\"name\":\"ComposeExecuted\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"LZ_ENDPOINT\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"SUPER_DESTINATION_EXECUTOR\",\"outputs\":[{\"internalType\":\"contract ISuperDestinationExecutor\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_from\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"_message\",\"type\":\"bytes\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"name\":\"lzCompose\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"author\":\"Superform Labs\",\"details\":\"Supports both Stargate pool tokens (taxi/bus modes) and generic OFT tokensToken delivery happens in a separate transaction (lzReceive) before lzCompose is calledWARNING: This contract uses balance-based transfers. If a prior compose failed and left dust,the next successful compose will sweep all held tokens (including dust) to its target account.\",\"errors\":{\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"events\":{\"ComposeExecuted(address,address,uint256)\":{\"params\":{\"account\":\"The target account that received the tokens\",\"amount\":\"The amount of tokens transferred\",\"tokenSent\":\"The token address transferred (address(0) for native ETH)\"}}},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"lzEndpoint_\":\"The LayerZero V2 EndpointV2 address\",\"superDestinationExecutor_\":\"The SuperDestinationExecutor address\"}},\"lzCompose(address,bytes32,bytes,address,bytes)\":{\"details\":\"Decodes the OFTComposeMsgCodec message, transfers tokens to the target account,      and forwards the execution payload to SuperDestinationExecutorThe _from parameter is the destination Stargate pool or OFT contract (NOT the source chain sender)Uses balance-based transfers: transfers full adapter balance of the identified token\",\"params\":{\"_executor\":\"The address of the executor for the composed message\",\"_extraData\":\"Additional arbitrary data passed by the executor\",\"_from\":\"The address initiating the composition (destination OApp/pool, NOT the source chain sender)\",\"_guid\":\"The unique identifier for the corresponding LayerZero src/dst tx\",\"_message\":\"The composed message payload (OFTComposeMsgCodec-encoded)\"}}},\"stateVariables\":{\"COMPOSE_MSG_OFFSET\":{\"details\":\"Layout: nonce(8) + srcEid(4) + amountLD(32) + composeFrom(32) = 76 bytes header\"},\"LZ_ENDPOINT\":{\"details\":\"Same on all EVM chains: 0x1a44076050125825900e736c501f859c50fE728c\"}},\"title\":\"StargateAdapter\",\"version\":1},\"userdoc\":{\"errors\":{\"ADDRESS_NOT_VALID()\":[{\"notice\":\"Thrown when a constructor argument is the zero address\"}],\"COMPOSE_MSG_TOO_SHORT()\":[{\"notice\":\"Thrown when the compose message is too short to contain the OFTComposeMsgCodec header\"}],\"ETH_TRANSFER_FAILED()\":[{\"notice\":\"Thrown when native ETH transfer to the target account fails\"}],\"INVALID_SENDER()\":[{\"notice\":\"Thrown when lzCompose is called by an address other than the LZ endpoint\"}]},\"events\":{\"ComposeExecuted(address,address,uint256)\":{\"notice\":\"Emitted when a compose message is successfully executed\"}},\"kind\":\"user\",\"methods\":{\"LZ_ENDPOINT()\":{\"notice\":\"The LayerZero V2 EndpointV2 address\"},\"SUPER_DESTINATION_EXECUTOR()\":{\"notice\":\"The SuperDestinationExecutor for processing bridged executions\"},\"lzCompose(address,bytes32,bytes,address,bytes)\":{\"notice\":\"Composes a LayerZero message from an OApp\"}},\"notice\":\"Receives LayerZero V2 compose messag