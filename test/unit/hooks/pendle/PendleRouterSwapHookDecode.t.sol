pragma solidity >=0.8.30;

import { Test, console } from "forge-std/Test.sol";
import { BytesLib } from "../../../../src/vendor/BytesLib.sol";
import {
    IPendleRouterV4,
    ApproxParams,
    TokenInput,
    LimitOrderData,
    TokenOutput,
    FillOrderParams,
    Order,
    SwapData,
    SwapType,
    OrderType
} from "../../../../src/vendor/pendle/IPendleRouterV4.sol";

contract PendleRouterSwapHookDecodeTest is Test {
    using BytesLib for bytes;

    function test_DecodeInputData() public pure {
        // Data from inputExample.txt
        // Hook data structure:
        // - bytes32 placeholder (0-31)
        // - address yieldSource (32-51) = 0x9a4e45841ddb012f1946372e8bd9d65bb17a7768
        // - bool usePrevHookAmount (52)
        // - uint256 value (53-84) = 0
        // - bytes txData (85+)
        bytes memory data = hex"";

        console.log("=== HOOK DATA LAYOUT ===");
        console.log("Total data length:", data.length);

        // Decode hook-level data structure
        // bytes32 placeholder = bytes32(BytesLib.slice(data, 0, 32), 0);
        bytes32 placeholder = bytes32(BytesLib.slice(data, 0, 32));
        console.log("\n--- Hook Level Data ---");
        console.log("Placeholder (bytes32):");
        console.logBytes32(placeholder);

        // address yieldSource = BytesLib.toAddress(data, 32);
        address yieldSource = BytesLib.toAddress(data, 32);
        console.log("Yield Source (market):", yieldSource);

        // bool usePrevHookAmount = _decodeBool(data, 52);
        bool usePrevHookAmount = uint8(data[52]) == 1;
        console.log("usePrevHookAmount:", usePrevHookAmount);

        // uint256 value = BytesLib.toUint256(data, 53);
        uint256 value = BytesLib.toUint256(data, 53);
        console.log("Value:", value);

        // bytes txData_ = BytesLib.slice(data, 85, data.length - 85);
        bytes memory txData = BytesLib.slice(data, 85, data.length - 85);
        console.log("\nTxData length:", txData.length);

        // Decode the function selector
        bytes4 selector = bytes4(BytesLib.slice(txData, 0, 4));
        console.log("\n--- TxData Selector ---");
        console.log("Selector:");
        console.logBytes4(selector);
        console.log("swapExactTokenForPt selector:");
        console.logBytes4(IPendleRouterV4.swapExactTokenForPt.selector);

        bool isSwapExactTokenForPt = selector == IPendleRouterV4.swapExactTokenForPt.selector;
        console.log("Is swapExactTokenForPt:", isSwapExactTokenForPt);

        if (isSwapExactTokenForPt) {
            // Decode swapExactTokenForPt parameters
            (
                address receiver,
                address market,
                uint256 minPtOut,
                ApproxParams memory guessPtOut,
                TokenInput memory input,
                LimitOrderData memory limit
            ) = abi.decode(BytesLib.slice(txData, 4, txData.length - 4),
                (address, address, uint256, ApproxParams, TokenInput, LimitOrderData));

            console.log("\n=== swapExactTokenForPt PARAMETERS ===");
            console.log("\n--- Basic Parameters ---");
            console.log("receiver:", receiver);
            console.log("market:", market);
            console.log("minPtOut:", minPtOut);

            console.log("\n--- ApproxParams (guessPtOut) ---");
            console.log("guessMin:", guessPtOut.guessMin);
            console.log("guessMax:", guessPtOut.guessMax);
            console.log("guessOffchain:", guessPtOut.guessOffchain);
            console.log("maxIteration:", guessPtOut.maxIteration);
            console.log("eps:", guessPtOut.eps);

            console.log("\n--- TokenInput ---");
            console.log("tokenIn:", input.tokenIn);
            console.log("netTokenIn:", input.netTokenIn);
            console.log("tokenMintSy:", input.tokenMintSy);
            console.log("pendleSwap:", input.pendleSwap);
            console.log("swapData.swapType:", uint8(input.swapData.swapType));
            console.log("swapData.extRouter:", input.swapData.extRouter);
            console.log("swapData.needScale:", input.swapData.needScale);
            console.log("swapData.extCalldata length:", input.swapData.extCalldata.length);

            console.log("\n--- LimitOrderData ---");
            console.log("limitRouter:", limit.limitRouter);
            console.log("epsSkipMarket:", limit.epsSkipMarket);
            console.log("normalFills length:", limit.normalFills.length);
            console.log("flashFills length:", limit.flashFills.length);
            console.log("optData length:", limit.optData.length);

            // Additional analysis
            console.log("\n=== ANALYSIS ===");
            console.log("If usePrevHookAmount is true, netTokenIn will be replaced by prevHook.getOutAmount()");
            console.log("Current netTokenIn:", input.netTokenIn);
            console.log("guessPtOut guessMin:", guessPtOut.guessMin);
            console.log("guessPtOut guessMax:", guessPtOut.guessMax);
            console.log("guessOffchain:", guessPtOut.guessOffchain);

            // Check if guessPtOut is reasonable for the input amount
            if (input.netTokenIn > 0) {
                // Rough ratio check
                uint256 ratioMin = (guessPtOut.guessMin * 1e18) / input.netTokenIn;
                uint256 ratioMax = (guessPtOut.guessMax * 1e18) / input.netTokenIn;
                uint256 ratioOffchain = (guessPtOut.guessOffchain * 1e18) / input.netTokenIn;
                console.log("\nRatio guessMin/netTokenIn (1e18):", ratioMin);
                console.log("Ratio guessMax/netTokenIn (1e18):", ratioMax);
                console.log("Ratio guessOffchain/netTokenIn (1e18):", ratioOffchain);
            }
        }
    }
}
