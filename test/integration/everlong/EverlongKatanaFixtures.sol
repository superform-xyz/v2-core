pragma solidity 0.8.30;

/// @title EverlongKatanaFixtures
/// @author Superform Labs
/// @notice Pinned Katana (747474) addresses and REAL Everlong Swap API calldata captured on 2026-11-12 from
///         `GET https://swap.foreverlong.io/v1/swap` (x-api-key test key, recipient = API_RECIPIENT, slippage 50 bps).
/// Each sample is the untouched `tx.data`: a SwapRouter02 `multicall(deadline, calls)` with exact-input V3 legs paying
///         the router, one sweep/unwrap tail (4 bps fee) paying the recipient, and `refundETH` for native input.
/// @dev Deadlines are fixed by the API at quote time + 600 s; they are ~3.96 h AFTER the pinned block's timestamp
///      (1794467711), so the samples execute at KATANA_BLOCK and are expired on any later fork. The tail recipient word
///      is the ONLY fixture mutation (`_withRecipient`), mirroring a quote requested with `recipient = account`; the
/// hooks validate it against the executing account. Header mins used by the tests are POST-fee (tail min x 9996 /
/// 10000).
abstract contract EverlongKatanaFixtures {
    uint256 internal constant KATANA_CHAIN_ID = 747_474;
    uint256 internal constant KATANA_BLOCK = 47_724_900;
    uint256 internal constant KATANA_PER_TX_GAS_CAP = 16_777_216;

    address internal constant EVERLONG_ROUTER = 0x42eF97FaE7AD46d98bAf99A0e505b43B7e1C00e9;
    address internal constant WETH9 = 0xEE7D8BCFb72bC1880D0Cf19822eB0A2e6577aB62; // vbETH
    address internal constant VB_USDC = 0x203A662b0BD271A6ed5a60EdFbd04bFce608FD36;
    address internal constant KAT = 0x7F1f4b4b29f5058fA32CC7a97141b8D7e5ABDC2d;
    address internal constant NATIVE = 0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE;
    address internal constant FEE_RECIPIENT = 0x631002609aC3d88097D31C8AeC7Ea48cF4c9C648;
    address internal constant API_RECIPIENT = 0x1111111111111111111111111111111111111111;
    uint256 internal constant FEE_BIPS = 4;

    // ─── Sample 1: vbUSDC 100e6 -> KAT (3 legs incl. a 2-hop exactInput; sweepTokenWithFee tail)
    // ──────────────
    uint256 internal constant QUOTE_USDC_KAT_IN = 100_000_000;
    uint256 internal constant QUOTE_USDC_KAT_OUT = 30_446_099_387_068_407_837_403;
    uint256 internal constant TAIL_MIN_USDC_KAT = 30_305_991_286_647_724_888_170;
    uint256 internal constant HEADER_MIN_USDC_KAT = TAIL_MIN_USDC_KAT * 9996 / 10_000;
    uint256 internal constant DEADLINE_USDC_KAT = 1_794_481_966;
    uint256 internal constant TAIL_RECIPIENT_OFFSET_USDC_KAT = 1256;
    bytes internal constant TX_USDC_KAT =
        hex"";

    // ─── Sample 2: native 1e18 -> vbUSDC (6 legs in WETH9; sweepTokenWithFee tail; refundETH)
    // ───────────────
    uint256 internal constant QUOTE_NATIVE_USDC_IN = 1_000_000_000_000_000_000;
    uint256 internal constant QUOTE_NATIVE_USDC_OUT = 2_037_089_175;
    uint256 internal constant TAIL_MIN_NATIVE_USDC = 2_027_714_814;
    uint256 internal constant HEADER_MIN_NATIVE_USDC = TAIL_MIN_NATIVE_USDC * 9996 / 10_000;
    uint256 internal constant DEADLINE_NATIVE_USDC = 1_794_481_968;
    uint256 internal constant TAIL_RECIPIENT_OFFSET_NATIVE_USDC = 2376;
    bytes internal constant TX_NATIVE_IN_USDC =
        hex"";

    // ─── Sample 3: vbUSDC 100e6 -> native (2 legs to WETH9; unwrapWETH9WithFee tail; refundETH)
    // ─────────────
    uint256 internal constant QUOTE_USDC_NATIVE_IN = 100_000_000;
    uint256 internal constant QUOTE_USDC_NATIVE_OUT = 48_839_320_993_056_171;
    uint256 internal constant TAIL_MIN_USDC_NATIVE = 48_614_570_216_177_360;
    uint256 internal constant HEADER_MIN_USDC_NATIVE = TAIL_MIN_USDC_NATIVE * 9996 / 10_000;
    uint256 internal constant DEADLINE_USDC_NATIVE = 1_794_481_969;
    uint256 internal constant TAIL_RECIPIENT_OFFSET_USDC_NATIVE = 872;
    bytes internal constant TX_USDC_NATIVE_OUT =
        hex"";

    // ─── Sample 4: KAT 30_000e18 -> vbUSDC (sweepTokenWithFee tail) — closes the cross-aggregator chains
    // ─────
    // Quoted with slippage 300 bps (not 50) because it was captured ~5 h after the pinned block, where KAT is cheaper:
    // the wider tail floor keeps the sample executable at KATANA_BLOCK. The hook's own header floor is post-fee.
    uint256 internal constant QUOTE_KAT_USDC_IN = 30_000_000_000_000_000_000_000;
    uint256 internal constant QUOTE_KAT_USDC_OUT = 97_044_308;
    uint256 internal constant TAIL_MIN_KAT_USDC = 94_170_646;
    uint256 internal constant HEADER_MIN_KAT_USDC = TAIL_MIN_KAT_USDC * 9996 / 10_000;
    uint256 internal constant DEADLINE_KAT_USDC = 1_794_485_020;
    uint256 internal constant TAIL_RECIPIENT_OFFSET_KAT_USDC = 1640;
    bytes internal constant TX_KAT_USDC =
        hex"";

    /// @dev Copy of `raw` with the tail recipient word rewritten to `account` (see contract NatSpec).
    function _withRecipient(bytes memory raw, uint256 offset, address account) internal pure returns (bytes memory d) {
        d = bytes.concat(raw);
        require(address(uint160(_word(d, offset))) == API_RECIPIENT, "fixture: unexpected recipient");
        _write(d, offset, uint256(uint160(account)));
    }

    /// @dev Standard 10-field swap hook data: 52-byte zero header + Layer 1 + abi.encode(bytes txData).
    function _hookData(
        address inputToken,
        address outputToken,
        uint256 inputAmount,
        uint256 outputQuote,
        uint256 outputMin,
        bool usePrevHookAmount,
        bytes memory txData
    )
        internal
        pure
        returns (bytes memory)
    {
        bytes memory payload = abi.encode(txData);
        return bytes.concat(
            new bytes(52),
            bytes20(inputToken),
            bytes20(outputToken),
            bytes32(inputAmount),
            bytes32(outputQuote),
            bytes32(outputMin),
            bytes1(usePrevHookAmount ? uint8(1) : uint8(0)),
            bytes32(payload.length),
            payload
        );
    }

    function _word(bytes memory d, uint256 off) internal pure returns (uint256 w) {
        assembly ("memory-safe") {
            w := mload(add(add(d, 0x20), off))
        }
    }

    function _write(bytes memory d, uint256 off, uint256 v) internal pure {
        assembly ("memory-safe") {
            mstore(add(add(d, 0x20), off), v)
        }
    }
}
