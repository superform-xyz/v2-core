pragma solidity 0.8.30;

/// @title SushiKatanaFixtures
/// @author Superform Labs
/// @notice Pinned Katana (747474) addresses and REAL SushiSwap v7 API calldata samples captured on 2026-11-12 from
///         `https://api.sushi.com/swap/v7/747474` (maxSlippage 0.005, sender = recipient = API_SENDER). Each sample is
///         the untouched `tx.data`: a `RedSnwapper.snwap` call whose executorData is a nested RouteProcessor
///         `processRoute`. The probe that validated them at KATANA_BLOCK is documented in
///         `.claude/doc/SushiSwapHook/katana-fork-probe-2026-11-12.md`.
/// @dev The API bakes the quoting account into words 68 (outer recipient) and 392 (nested `to`). Production quotes are
///      requested with sender = recipient = the Superform account; a fork cannot re-quote for a deterministic account
///      address, so tests rewrite exactly those two words with `_withRecipient`. The hooks validate both against the
///      executing account, so a wrong rewrite is caught, not silently accepted.
abstract contract SushiKatanaFixtures {
    uint256 internal constant KATANA_CHAIN_ID = 747_474;
    /// @dev Probe-validated block; the samples were captured minutes earlier (~47,724,888).
    uint256 internal constant KATANA_BLOCK = 47_724_900;
    /// @dev Katana caps a single transaction at 2^24 gas.
    uint256 internal constant KATANA_PER_TX_GAS_CAP = 16_777_216;

    address internal constant RED_SNWAPPER = 0xAC4c6e212A361c968F1725b4d055b47E63F80b75;
    address internal constant ROUTE_PROCESSOR = 0xC10eE9031F2a0B84766A86B55a8D90F357910fb4;
    address internal constant VB_USDC = 0x203A662b0BD271A6ed5a60EdFbd04bFce608FD36; // 6 decimals
    address internal constant KAT = 0x7F1f4b4b29f5058fA32CC7a97141b8D7e5ABDC2d; // 18 decimals
    address internal constant WETH = 0xEE7D8BCFb72bC1880D0Cf19822eB0A2e6577aB62;
    address internal constant NATIVE = 0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE;
    address internal constant API_SENDER = 0x1111111111111111111111111111111111111111;

    uint256 internal constant OUTER_RECIPIENT_SLOT = 68;
    uint256 internal constant INNER_TO_SLOT = 392;

    // ─── Sample 1: vbUSDC 100e6 -> KAT (single UniV3 pool, 81-byte route)
    // ───────────────────────────────────
    uint256 internal constant QUOTE_USDC_KAT_IN = 100_000_000;
    uint256 internal constant QUOTE_USDC_KAT_OUT = 30_932_333_548_926_897_487_872;
    uint256 internal constant OUTER_MIN_USDC_KAT = 30_777_671_881_182_263_000_432;
    bytes internal constant TX_USDC_KAT =
        hex"";

    // ─── Sample 2: NATIVE 1e18 -> vbUSDC (wrapNative -> WETH -> pool, 302-byte route; tx.value = 1e18)
    // ───────
    uint256 internal constant QUOTE_NATIVE_USDC_IN = 1_000_000_000_000_000_000;
    uint256 internal constant QUOTE_NATIVE_USDC_OUT = 2_038_313_022;
    uint256 internal constant OUTER_MIN_NATIVE_USDC = 2_028_121_456;
    bytes internal constant TX_NATIVE_IN_USDC =
        hex"";

    // ─── Sample 3: vbUSDC 100e6 -> NATIVE (127-byte route; native paid to the recipient)
    // ─────────────────────
    uint256 internal constant QUOTE_USDC_NATIVE_IN = 100_000_000;
    uint256 internal constant QUOTE_USDC_NATIVE_OUT = 48_839_217_421_438_248;
    uint256 internal constant OUTER_MIN_USDC_NATIVE = 48_595_021_334_331_056;
    bytes internal constant TX_USDC_NATIVE_OUT =
        hex"";

    // ─── Sample 4: vbUSDC 5e10 -> WETH (multi-split route, 358 bytes)
    // ────────────────────────────────────────
    uint256 internal constant QUOTE_USDC_WETH_IN = 50_000_000_000;
    uint256 internal constant QUOTE_USDC_WETH_OUT = 23_972_676_932_015_955_968;
    uint256 internal constant OUTER_MIN_USDC_WETH = 23_852_813_547_355_876_188;
    bytes internal constant TX_USDC_WETH_MULTI =
        hex"";

    /// @dev Copy of `raw` with the two recipient words rewritten to `account` (see contract NatSpec).
    function _withRecipient(bytes memory raw, address account) internal pure returns (bytes memory d) {
        d = bytes.concat(raw);
        require(address(uint160(_word(d, OUTER_RECIPIENT_SLOT))) == API_SENDER, "fixture: unexpected recipient");
        require(address(uint160(_word(d, INNER_TO_SLOT))) == API_SENDER, "fixture: unexpected inner to");
        _write(d, OUTER_RECIPIENT_SLOT, uint256(uint160(account)));
        _write(d, INNER_TO_SLOT, uint256(uint160(account)));
    }

    /// @dev Standard 10-field swap hook data: 52-byte zero header + Layer 1 + abi.encode(bytes txData).
    function _hookData(
        address inputToken,
        address outputToken,
        uint256 inputAmount,
        uint256 outputQuote,
        uint256 outputMin,
        bool usePrevHookAmount,
        bytes memory txData
    )
        internal
        pure
        returns (bytes memory)
    {
        bytes memory payload = abi.encode(txData);
        return bytes.concat(
            new bytes(52),
            bytes20(inputToken),
            bytes20(outputToken),
            bytes32(inputAmount),
            bytes32(outputQuote),
            bytes32(outputMin),
            bytes1(usePrevHookAmount ? uint8(1) : uint8(0)),
            bytes32(payload.length),
            payload
        );
    }

    function _word(bytes memory d, uint256 off) internal pure returns (uint256 w) {
        assembly ("memory-safe") {
            w := mload(add(add(d, 0x20), off))
        }
    }

    function _write(bytes memory d, uint256 off, uint256 v) internal pure {
        assembly ("memory-safe") {
            mstore(add(add(d, 0x20), off), v)
        }
    }
}
